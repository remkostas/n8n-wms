# Copy to .env and fill in. Generate secrets with: openssl rand -hex 24

POSTGRES_USER=wms
POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me

# Where the two services listen. Loopback by default; set to a LAN/VPN address
# to open the terminal from a phone or handheld scanner.
N8N_BIND=127.0.0.1:5678
POSTGRES_BIND=127.0.0.1:55432

# Used by scripts/setup.sh to create the n8n owner account. Demo values only.
N8N_OWNER_EMAIL=owner@example.com
N8N_OWNER_PASSWORD=Demo-Password-1

TZ=Europe/Berlin
